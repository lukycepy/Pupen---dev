NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://pupen.org
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
SITE_CONFIG_ID=1
DATABASE_URL=
DATABASE_URL_STAGING=
DATABASE_URL_PROD=
# Lokální/scratch databáze pro `restore:db --env local` (test obnovy mimo produkci).
DATABASE_URL_LOCAL=
# 'true' spustí i legacy SQL z `migrace/` (jinak se použije jen `supabase/migrations`).
MIGRATE_INCLUDE_LEGACY=false
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-889DM5DL7F
SUPABASE_SERVICE_ROLE_KEY=
APPS_DATA_DIR=/var/www/pupen.org/apps

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TLS_CA_PEM=
# Odesílatel systémových e-mailů (fallback, primárně se bere z DB).
EMAIL_FROM=
# 'true' povolí testovací e-mailový endpoint – NIKDY v produkci.
ENABLE_EMAIL_TESTS=false

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CRON_SECRET=

BANK_ACCOUNT=
INVOICE_EMAIL=

PUPEN_FIO_WEBHOOK_SECRET=
# Ověření webhooku pro e-mailové bouncy.
BOUNCE_WEBHOOK_SECRET=
# Podepisování odkazů v přihláškách (fallback na service-role klíč).
APPLICATION_LINK_SECRET=
# Jednorázový secret pro bootstrap superadmina přes /api/bootstrap/superadmin.
PUPEN_BOOTSTRAP_SECRET=

# Google Gemini API klíč (OCR endpoint /api/ocr).
GOOGLE_AI_API_KEY=

# Cache TTL slovníku (ms), výchozí hodnota v lib/get-dictionary.ts.
PUPEN_DICTIONARY_CACHE_TTL_MS=

# '1' přepne CSP z Report-Only na vynucený režim.
CSP_ENFORCE=
# Čárkou oddělené domény povolené pro next/image.
NEXT_IMAGE_REMOTE_HOSTS=

# Sentry / telemetrie (volitelné – bez DSN je Sentry vypnutý)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- E2E integrační testy (Ostatní/tests) --------------------------------
# Bez těchto proměnných se integrační scénáře přeskočí (`test.skip`).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Zálohy a obnova (Ostatní/scripts/ops) -------------------------------
# Cílová složka pro artefakty záloh (výchozí `ops/backup-artifacts`).
BACKUP_DIR=
# Konkrétní buckety pro zálohu storu (čárkou oddělené); prázdné = jen privátní.
BACKUP_STORAGE_BUCKETS=
# 'true' zahrne do zálohy storu i veřejné buckety.
BACKUP_STORAGE_INCLUDE_PUBLIC=false
# Paralelismus stahování objektů při záloze storu (výchozí 4).
BACKUP_STORAGE_CONCURRENCY=4

# --- Poskytuje runtime / CI (nenastavovat ručně) -------------------------
# NODE_ENV, CI, NEXT_RUNTIME, PLAYWRIGHT_BROWSERS_PATH

